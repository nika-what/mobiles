<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Либеральная конфигурация для разработки - разрешает все SSL сертификаты -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Разрешаем системные сертификаты -->
            <certificates src="system" />
            <!-- Разрешаем пользовательские сертификаты (включая самоподписанные и невалидные) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- Специфичная конфигурация для Replit доменов -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">662d0bd5-11ca-4dae-b061-3f7d7b023522-00-1pniluegz7xbx.spock.replit.dev</domain>
        <domain includeSubdomains="true">spock.replit.dev</domain>
        <domain includeSubdomains="true">replit.dev</domain>
        <domain includeSubdomains="true">replit.com</domain>
        <trust-anchors>
            <!-- Разрешаем все типы сертификатов для этих доменов -->
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>

